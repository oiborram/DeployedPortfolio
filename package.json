{
  "name": "deployed-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oscar Iborra's software engineering and applied AI portfolio, with a JSON Resume representation.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build:data": "node scripts/build-resume.mjs",
    "build": "node scripts/build-site.mjs && node scripts/build-site.mjs --production",
    "validate:data": "node scripts/validate-resume.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "dependencies": {
    "gsap": "3.15.0"
  }
}
